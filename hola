import java.util.Scanner;

public class hola {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        System.out.print("Ingrese el nombre de la estudiante: ");
        String estudiante = scanner.nextLine();
        System.out.print("Ingrese el nombre del producto: ");
        String producto = scanner.nextLine();
        System.out.print("Ingrese la cantidad de unidades: ");
        int cantidad = scanner.nextInt();
        System.out.print("Ingrese el precio de cada unidad: ");
        double precioUnitario = scanner.nextDouble();
        double subtotal = cantidad * precioUnitario;
        double descuento = subtotal * 0.10; // 10% de descuento didáctico
        double total = subtotal - descuento;
        System.out.println("\n--- RESUMEN DE COMPRA ---");
        System.out.println("Estudiante: " + estudiante);
        System.out.println("Producto: " + producto);
        System.out.println("Subtotal: $" + subtotal);
        System.out.println("Descuento (10%): $" + descuento);
        System.out.println("Total a pagar: $" + total);
        System.out.print("\nIngrese el dinero entregado: ");
        double dineroEntregado = scanner.nextDouble();
        if (dineroEntregado >= total) {
            double cambio = dineroEntregado - total;
            System.out.println("¡Pago exitoso! Su cambio es: $" + cambio);
        } else {
            double falta = total - dineroEntregado;
            System.out.println("Dinero insuficiente. Le falta por pagar: $" + falta);
        }
        scanner.close();
    }
}
